<% layout('layout', { title: 'Articles', request: request }) %>

<section>
  <h2>Articles</h2>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (articles.length === 0) { %>
        <tr><td colspan="5" class="muted">No articles found. Add a new one.</td></tr>
      <% } %>
      <% articles.forEach(function(a){ %>
        <tr>
          <td><%= a.id %></td>
          <td><%= a.name %></td>
          <td><%= a.category %></td>
          <td><%= a.price.toFixed(2) %></td>
          <td class="actions">
            <a class="btn small" href="/articles/<%= a.id %>">View</a>
            <a class="btn small secondary" href="/articles/<%= a.id %>/edit">Edit</a>
            <form class="inline" method="post" action="/articles/<%= a.id %>/delete" onsubmit="return confirm('Delete this article?');">
              <button class="btn small danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
