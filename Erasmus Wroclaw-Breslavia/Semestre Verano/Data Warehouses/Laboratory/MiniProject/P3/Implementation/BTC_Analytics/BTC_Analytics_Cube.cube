      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Fee Sustainability Previous Month] AS
    (
        [Measures].[Fee Btc],
        ParallelPeriod([DIM_DATE].[Calendar].[Month], 1, [DIM_DATE].[Calendar].CurrentMember)
    )
    /
    (
        (
            [Measures].[Output Value Btc],
            ParallelPeriod([DIM_DATE].[Calendar].[Month], 1, [DIM_DATE].[Calendar].CurrentMember)
        )
        +
        (
            [Measures].[Fee Btc],
            ParallelPeriod([DIM_DATE].[Calendar].[Month], 1, [DIM_DATE].[Calendar].CurrentMember)
        )
    ) * 100,
    FORMAT_STRING = "0.00",
    VISIBLE = 0;   

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Fee Rate] AS
    [Measures].[Fee Rate Sat Vbyte] / [Measures].[Transaction Count],
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Fee Burden %] AS
    [Measures].[Fee Burden Pct] / [Measures].[Transaction Count],
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Avg IO Value Ratio] AS
    [Measures].[Io Value Ratio] / [Measures].[Transaction Count],
    FORMAT_STRING = "#,##0.0000",
    VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[SegWit Share %]
 AS Sum(
        Filter(
            [DIM_TX_TYPE].[Script Evolution].[Segwit Flag].MEMBERS,
            [DIM_TX_TYPE].[Script Evolution].CurrentMember.Properties("Key") = "1"
        ),
        [Measures].[Transaction Count]
    ) / [Measures].[Transaction Count] * 100, 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Coinbase Share %]
 AS Sum(
        Filter(
            [DIM_TX_TYPE].[Transaction Class].[Coinbase Flag].MEMBERS,
            [DIM_TX_TYPE].[Transaction Class].CurrentMember.Properties("Key") = "1"
        ),
        [Measures].[Transaction Count]
    ) / [Measures].[Transaction Count] * 100, 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="12d3e642-965a-4002-a3a9-16bf38fadcda">
      <ID>KPI</ID>
      <Name>Network Fee Sustainability</Name>
      <Value>[Measures].[Fee Btc] / ([Measures].[Output Value Btc] + [Measures].[Fee Btc]) * 100</Value>
      <Goal>5.0</Goal>
      <Status>CASE
    WHEN IsEmpty([Measures].[Fee Btc]) 
    THEN -1
    WHEN [Measures].[Fee Btc] / 
         ([Measures].[Output Value Btc] + [Measures].[Fee Btc]) * 100 &lt; 1 
    THEN -1
    WHEN [Measures].[Fee Btc] / 
         ([Measures].[Output Value Btc] + [Measures].[Fee Btc]) * 100 &lt;= 5 
    THEN 0
    ELSE 1
END</Status>
      <Trend>CASE
    WHEN IsEmpty([Measures].[Fee Btc]) 
    THEN 0
    WHEN 
        [Measures].[Fee Btc] / ([Measures].[Output Value Btc] + [Measures].[Fee Btc]) * 100
        &gt;
        [Measures].[Fee Sustainability Previous Month]
    THEN 1
    ELSE -1
END</Trend>
      <TrendGraphic>Smiley Face</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>