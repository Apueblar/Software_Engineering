    <DTS:Executable
      DTS:refId="Package\Preparation SQL Task 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{524B635E-8180-4544-BF31-6AEF55858A8F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Preparation SQL Task 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BFC62E7-1283-4085-A4C7-ED605D2C819D}"
          SQLTask:SqlStatementSource="-- CountryRegion&#xA;DROP TABLE IF EXISTS [dbo].[CountryRegion];&#xA;CREATE TABLE [dbo].[CountryRegion] (&#xA;    [CountryRegionCode] nvarchar(3)  NOT NULL,&#xA;    [Name]              nvarchar(50) NOT NULL,&#xA;    [ModifiedDate]      datetime     NOT NULL&#xA;);&#xA;GO&#xA;&#xA;-- ProductCategory&#xA;DROP TABLE IF EXISTS [dbo].[ProductCategory];&#xA;CREATE TABLE [dbo].[ProductCategory] (&#xA;    [ProductCategoryID] int              NOT NULL,&#xA;    [Name]              nvarchar(50)     NOT NULL,&#xA;    [rowguid]           uniqueidentifier NOT NULL,&#xA;    [ModifiedDate]      datetime         NOT NULL&#xA;);&#xA;GO&#xA;&#xA;-- ProductSubcategory&#xA;DROP TABLE IF EXISTS [dbo].[ProductSubcategory];&#xA;CREATE TABLE [dbo].[ProductSubcategory] (&#xA;    [ProductSubcategoryID] int              NOT NULL,&#xA;    [ProductCategoryID]    int              NOT NULL,&#xA;    [Name]                 nvarchar(50)     NOT NULL,&#xA;    [rowguid]              uniqueidentifier NOT NULL,&#xA;    [ModifiedDate]         datetime         NOT NULL&#xA;);&#xA;GO&#xA;&#xA;-- Product&#xA;DROP TABLE IF EXISTS [dbo].[Product];&#xA;CREATE TABLE [dbo].[Product] (&#xA;    [ProductID]             int              NOT NULL,&#xA;    [Name]                  nvarchar(50)     NOT NULL,&#xA;    [ProductNumber]         nvarchar(25)     NOT NULL,&#xA;    [MakeFlag]              bit              NOT NULL,&#xA;    [FinishedGoodsFlag]     bit              NOT NULL,&#xA;    [Color]                 nvarchar(15),&#xA;    [SafetyStockLevel]      smallint         NOT NULL,&#xA;    [ReorderPoint]          smallint         NOT NULL,&#xA;    [StandardCost]          money            NOT NULL,&#xA;    [ListPrice]             money            NOT NULL,&#xA;    [Size]                  nvarchar(5),&#xA;    [SizeUnitMeasureCode]   nchar(3),&#xA;    [WeightUnitMeasureCode] nchar(3),&#xA;    [Weight]                decimal(8,2),&#xA;    [DaysToManufacture]     int              NOT NULL,&#xA;    [ProductLine]           nchar(2),&#xA;    [Class]                 nchar(2),&#xA;    [Style]                 nchar(2),&#xA;    [ProductSubcategoryID]  int,&#xA;    [ProductModelID]        int,&#xA;    [SellStartDate]         datetime         NOT NULL,&#xA;    [SellEndDate]           datetime,&#xA;    [DiscontinuedDate]      datetime,&#xA;    [rowguid]               uniqueidentifier NOT NULL,&#xA;    [ModifiedDate]          datetime         NOT NULL&#xA;);&#xA;GO&#xA;&#xA;-- SalesOrderDetail&#xA;DROP TABLE IF EXISTS [dbo].[SalesOrderDetail];&#xA;CREATE TABLE [dbo].[SalesOrderDetail] (&#xA;    [SalesOrderID]          int              NOT NULL,&#xA;    [SalesOrderDetailID]    int              NOT NULL,&#xA;    [CarrierTrackingNumber] nvarchar(25),&#xA;    [OrderQty]              smallint         NOT NULL,&#xA;    [ProductID]             int              NOT NULL,&#xA;    [SpecialOfferID]        int              NOT NULL,&#xA;    [UnitPrice]             money            NOT NULL,&#xA;    [UnitPriceDiscount]     money            NOT NULL,&#xA;    [LineTotal]             numeric(38,6)    NOT NULL,&#xA;    [rowguid]               uniqueidentifier NOT NULL,&#xA;    [ModifiedDate]          datetime         NOT NULL&#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Preparation SQL Task 2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{34C2BD8F-536C-402F-AC10-38919506B772}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Preparation SQL Task 2"
