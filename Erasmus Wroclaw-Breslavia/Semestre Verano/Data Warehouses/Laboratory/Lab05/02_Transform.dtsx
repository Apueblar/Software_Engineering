      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('StagingDB.dbo.SalesPersonDIM') IS NOT NULL &#xA;    DROP TABLE StagingDB.dbo.SalesPersonDIM;&#xA;&#xA;CREATE TABLE StagingDB.dbo.SalesPersonDIM (&#xA;    SalesPersonKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    SalesPersonID INT,&#xA;    FullName       NVARCHAR(200),&#xA;    TerritoryName NVARCHAR(100)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create SalesTerritoryDIM Staging"
