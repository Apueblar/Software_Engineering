      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('StagingDB.dbo.SalesTerritoryDIM') IS NOT NULL &#xA;    DROP TABLE StagingDB.dbo.SalesTerritoryDIM;&#xA;&#xA;CREATE TABLE StagingDB.dbo.SalesTerritoryDIM (&#xA;    TerritoryKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    TerritoryID INT,&#xA;    TerritoryName NVARCHAR(100),&#xA;    CountryName NVARCHAR(100),&#xA;    TerritoryGroup NVARCHAR(50)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create TimeDIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create TimeDIM"
      DTS:DTSID="{CDA36C7D-EA90-44AE-8170-46425A666720}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create TimeDIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="4">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('StagingDB.dbo.TimeDIM') IS NOT NULL &#xA;    DROP TABLE StagingDB.dbo.TimeDIM;&#xA;&#xA;CREATE TABLE StagingDB.dbo.TimeDIM (&#xA;    TimeKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    FullDate DATE,&#xA;    Year INT,&#xA;    Month INT,&#xA;    Day INT,&#xA;    Quarter INT,&#xA;    DayOfWeek INT,&#xA;    WeekOfYear INT&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Populate ProductDIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate ProductDIM"
      DTS:DTSID="{6AA23DBA-7E3D-4E20-A660-72F464C1EE8C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Populate ProductDIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="INSERT INTO StagingDB.dbo.ProductDIM (ProductID, ProductName, SubcategoryName, CategoryName, Color)&#xA;SELECT &#xA;    p.ProductID,&#xA;    p.Name AS ProductName,&#xA;    ISNULL(ps.Name, 'Unknown') AS SubcategoryName,&#xA;    ISNULL(pc.Name, 'Unknown') AS CategoryName,&#xA;    ISNULL(p.Color, 'N/A') AS Color&#xA;FROM StagingDB.dbo.Product p&#xA;LEFT JOIN StagingDB.dbo.ProductSubcategory ps ON p.ProductSubcategoryID = ps.ProductSubcategoryID&#xA;LEFT JOIN StagingDB.dbo.ProductCategory pc ON ps.ProductCategoryID = pc.ProductCategoryID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Populate SalesFactStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate SalesFactStaging"
      DTS:DTSID="{EE623A70-FDB4-4074-A7C1-B3529C6D7001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Populate SalesFactStaging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="INSERT INTO StagingDB.dbo.SalesFactStaging&#xA;    (OrderDetailID, ProductKey, TimeKey, SalesPersonKey, TerritoryKey, Quantity, UnitPrice, TotalAmount)&#xA;SELECT&#xA;    sod.SalesOrderDetailID,&#xA;    pd.ProductKey,&#xA;    td.TimeKey,&#xA;    ISNULL(spd.SalesPersonKey, -1),&#xA;    ISNULL(std.TerritoryKey,  -1),&#xA;    sod.OrderQty,&#xA;    sod.UnitPrice,&#xA;    sod.LineTotal&#xA;FROM StagingDB.dbo.SalesOrderDetail sod&#xA;JOIN StagingDB.dbo.SalesOrderHeader soh ON sod.SalesOrderID    = soh.SalesOrderID&#xA;JOIN StagingDB.dbo.ProductDIM       pd  ON sod.ProductID       = pd.ProductID&#xA;JOIN StagingDB.dbo.TimeDIM          td  ON CAST(soh.OrderDate AS DATE) = td.FullDate&#xA;LEFT JOIN StagingDB.dbo.SalesPersonDIM    spd ON soh.SalesPersonID = spd.SalesPersonID&#xA;LEFT JOIN StagingDB.dbo.SalesTerritoryDIM std ON soh.TerritoryID   = std.TerritoryID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Populate TimeDIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate TimeDIM"
      DTS:DTSID="{BE32D870-D6A9-4C0D-B12B-2E8AD12355B6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Populate TimeDIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="4">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="INSERT INTO StagingDB.dbo.TimeDIM (FullDate, Year, Month, Day, Quarter, DayOfWeek, WeekOfYear)&#xA;SELECT DISTINCT&#xA;    CAST(soh.OrderDate AS DATE) AS FullDate,&#xA;    YEAR(soh.OrderDate) AS Year,&#xA;    MONTH(soh.OrderDate) AS Month,&#xA;    DAY(soh.OrderDate) AS Day,&#xA;    DATEPART(QUARTER, soh.OrderDate) AS Quarter,&#xA;    DATEPART(WEEKDAY, soh.OrderDate) AS DayOfWeek,&#xA;    DATEPART(WEEK, soh.OrderDate) AS WeekOfYear&#xA;FROM StagingDB.dbo.SalesOrderHeader soh&#xA;ORDER BY FullDate;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
