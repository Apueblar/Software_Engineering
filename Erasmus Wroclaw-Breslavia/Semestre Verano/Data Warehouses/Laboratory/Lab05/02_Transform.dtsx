    <DTS:Executable
      DTS:refId="Package\Create ProductDIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create ProductDIM"
      DTS:DTSID="{48703D56-A86E-4277-8669-8DC8A25A5F6B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create ProductDIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('StagingDB.dbo.ProductDIM') IS NOT NULL &#xA;    DROP TABLE StagingDB.dbo.ProductDIM;&#xA;&#xA;CREATE TABLE StagingDB.dbo.ProductDIM (&#xA;    ProductKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ProductID INT,&#xA;    ProductName NVARCHAR(200),&#xA;    SubcategoryName NVARCHAR(100),&#xA;    CategoryName NVARCHAR(100),&#xA;    Color NVARCHAR(50)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create SalesFactStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create SalesFactStaging"
      DTS:DTSID="{AC410DC2-83DA-46DC-998E-CF0CE081E620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create SalesFactStaging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B7C723D2-466F-457D-9B53-8FA72CFD82C2}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('StagingDB.dbo.SalesFactStaging') IS NOT NULL &#xA;    DROP TABLE StagingDB.dbo.SalesFactStaging;&#xA;&#xA;CREATE TABLE StagingDB.dbo.SalesFactStaging (&#xA;    OrderDetailID  INT,&#xA;    ProductKey     INT,&#xA;    TimeKey        INT,&#xA;    SalesPersonKey INT,&#xA;    TerritoryKey   INT,&#xA;    Quantity       INT,&#xA;    UnitPrice      MONEY,&#xA;    TotalAmount    MONEY&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
